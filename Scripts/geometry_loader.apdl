
! Importo la geometria come parasolid
/AUX15
~PARAIN,pannello_cleaned_v2,,,SURFACES,,,
ASEL,ALL
APLOT
!--------------------------------

/PREP7
! Nascondo i warning
/UIS,MSGPOP,3
/NERR,,99999999,,0,0
!--------------------------------
! Inizio la pulizia della geometria: la ROI non è effettivamente planare, seleziono il nodo più alto e sposto tutti i nodi della ROI a quella z (così diventa planare)
 *GET,z_massima,KP,0,MXLOC,Z,,,
 *GET,z_minima,KP,0,MNLOC,Z,,,
 tol = 5e-3
! KSEL,S,LOC,Z,z_massima-tol,z_massima+tol
! LSLK,S,1
! ASLL,S,1
! APLOT
! LSEL,ALL
! ASEL,ALL
! KMODIF,ALL,,,z_massima
! !--------------------------------
! ! Recupero l'id della ROI e creo degli hardpoint nella posizione delle probe: non lavoro con mesh strutturata ma ottengo un nodo esattamente dove voglio campionare lo strain
KSEL,S,LOC,Z,z_massima-tol,z_massima+tol
LSLK,S,1
ASLL,S,1
*GET,area_id,AREA,,NUM,MIN
APLOT
value_1 = 0.4
value_2 = 0.1767
!  HPTCREATE,AREA,area_id,1001,COORD,0,-value_1,z_massima
! HPTCREATE,AREA,area_id,1002,COORD,value_1,0,z_massima
HPTCREATE,LINE,8,2003,COORD,0,value_1,z_massima
 HPTCREATE,LINE,9,2004,COORD,-value_1,0,z_massima
! HPTCREATE,AREA,area_id,1005,COORD,value_2,-value_2,z_massima
!  HPTCREATE,AREA,area_id,1006,COORD,-value_2,-value_2,z_massima
HPTCREATE,AREA,area_id,2007,COORD,-value_2,value_2,z_massima
! HPTCREATE,AREA,area_id,1008,COORD,value_2,value_2,z_massima
! !---------------------------------
! Seleziono tutta la geometria
KSEL,ALL
LSEL,ALL
ASEL,ALL
!---------------------------------
! Definisco i materiali e il tipo di elemento che voglio utilizzare

MP,DENS,1,870
MP,EX,1,53e9 
MP,EY,1,53e9
MP,EZ,1,1e9
MP,PRXY,1,0.2
MP,PRXZ,1,0.3
MP,PRYZ,1,0.3
MP,GXY,1,3.3e9
MP,GYZ,1,1e9
MP,GXZ,1,1e9
THICK1 = 0.00023

MP,DENS,2,970
MP,EX,2,59e9 
MP,EY,2,59e9
MP,EZ,2,1e9
MP,PRXY,2,0.2
MP,PRXZ,2,0.3
MP,PRYZ,2,0.3
MP,GXY,2,3.3e9
MP,GYZ,2,1e9
MP,GXZ,2,1e9
THICK2 = 0.00065

ET,1,SHELL281
KEYOPT,1,5,1  ! Trascuro gli effetti di curvature iniziale dato che la ROI è planare
KEYOPT,1,8,1

SECTYPE,1,SHELL,,laminato
SECDATA,THICK1,1,45,5
SECDATA,THICK2,2,45,5
SECDATA,THICK2,2,0,3
SECDATA,THICK2,2,0,3
SECDATA,THICK2,2,0,3
SECDATA,THICK2,2,0,3
SECDATA,THICK1,1,45,3

SECTYPE,2,SHELL,,TEMP
SECDATA,THICK1,1,0,3

!ESIZE,0.05
TYPE,2
SECNUM,2
MSHKEY,2
MSHAPE,0,2D
AESIZE,area_id,0.025
SMRTSIZE,6
AMESH,ALL

NSYM,X,10000,ALL
ESYM,,10000,ALL

NUMMRG,NODE
NUMMRG,ELEM

NSYM,Y,20000,ALL
ESYM,,20000,ALL

NUMMRG,NODE
NUMMRG,ELEM

! Rendo omogenee le normali
ESEL,S,CENT,Z,z_massima-tol*0.1,z_massima+tol*0.1
*GET,id_normale_positiva,ELEM,,NUM,MIN
ESEL,ALL
ENORM,id_normale_positiva
ESEL,ALL
EPLOT

!--------------------------
! ! Creo i nuovi SYS per i vari elementi
/INPUT,SYS_orienter.apdl,,"C:\Users\gvent\OneDrive\Desktop\CAD FEM\full_sim"
/PREP7
! !--------------------------
! ! Assegno la sezione corretta
ESEL,ALL
EMODIF,ALL,SECNUM,1

!--------------------------


! !--------------------------
! ! Vincolo i fori
! hole_center = 0.455
! radius = 6e-3
! LSEL,ALL
! LSEL,S,LOC,Y,hole_center - radius,hole_center + radius
! CM,upper_line,LINE
! LSEL,ALL
! LSEL,S,LOC,Y,-hole_center-radius,-hole_center + radius
! CM,lower_line,LINE
! LSEL,ALL
! LSEL,S,LOC,X,-hole_center-radius,-hole_center + radius
! CM,left_line,LINE
! LSEL,ALL
! LSEL,S,LOC,X,hole_center-radius,hole_center + radius
! CM,right_line,LINE
! CMGRP,holes_lines,left_line,right_line,upper_line,lower_line
! CMSEL,S,holes_lines
! LSEL,S,LINE,,holes_lines
! NSEL,ALL
! NSLL,S,1

NSEL,S,LOC,Z,z_minima,z_minima,

D,ALL,UX,0
D,ALL,UY,0
D,ALL,UZ,0
D,ALL,ROTX,0
D,ALL,ROTY,0
D,ALL,ROTZ,0

! !-------------------
! ! Creo gli array con i dati di interesse
*DIM,x_nodes_array,ARRAY,8
*DIM,y_nodes_array,ARRAY,8
*DIM,FBG_nodes_id,ARRAY,8
x_nodes_array(1) = 0
x_nodes_array(2) = 0.4
x_nodes_array(3) = 0
x_nodes_array(4) = -0.4
x_nodes_array(5) = 0.1767
x_nodes_array(6) = -0.1767
x_nodes_array(7) = -0.1767
x_nodes_array(8) = 0.1767

y_nodes_array(1) = -0.4
y_nodes_array(2) = 0
y_nodes_array(3) = 0.4
y_nodes_array(4) = 0
y_nodes_array(5) = -0.1767
y_nodes_array(6) = -0.1767
y_nodes_array(7) = 0.1767
y_nodes_array(8) = 0.1767

X0 = x_nodes_array(1)
Y0 = y_nodes_array(1)

NSEL,S,LOC,X,X0,X0
NSEL,R,LOC,Y,Y0,Y0
*GET,node_id,NODE,0,NUM,MIN
FBG_nodes_id(1) = node_id

*DO,i,2,8,
	NSEL,ALL
	X0 = x_nodes_array(i)
	Y0 = y_nodes_array(i)
	NSEL,S,LOC,X,X0,X0
	NSEL,R,LOC,Y,Y0,Y0
	*GET,node_id,NODE,0,NUM,MIN
	FBG_nodes_id(i) = node_id
*ENDDO

NSEL,S,NODE,,FBG_nodes_id(1)
*DO,J,2,8
	NSEL,A,NODE,,FBG_nodes_id(J)
*ENDDO

ESLN,S,0,
CM,fbg_elems,ELEM